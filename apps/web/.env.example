# Copy to .env.local and fill in real values once a Supabase project
# exists. Until then, apps/web/.env.local can hold correctly-*shaped*
# placeholders (a well-formed URL, a non-empty string) so `pnpm dev` and
# `pnpm build` succeed — see lib/env.client.ts / lib/env.server.ts, which
# validate shape, not liveness.

# Supabase project settings → API. Using Supabase's newer publishable/
# secret key system (sb_publishable_.../sb_secret_...) — the legacy anon/
# service_role JWT-format keys work identically if that's what you have.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# NEVER prefix this with NEXT_PUBLIC_. Server Actions / Route Handlers
# only — see lib/supabase/admin.ts and §18.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_OR_SECRET_KEY"

# Monnify (§12's payment provider — Paystack in the original architecture
# doc, swapped to Monnify per project decision). MONNIFY_API_KEY and
# MONNIFY_API_SECRET together form the Basic Auth header Monnify's API
# expects; MONNIFY_CONTRACT_CODE identifies the merchant contract.
# MK_TEST_... keys are sandbox — use MONNIFY_BASE_URL=https://sandbox.monnify.com
# for those, https://api.monnify.com once live keys replace them.
MONNIFY_API_KEY="MK_TEST_..."
MONNIFY_API_SECRET="YOUR_MONNIFY_SECRET_KEY"
MONNIFY_CONTRACT_CODE="YOUR_CONTRACT_CODE"
MONNIFY_BASE_URL="https://sandbox.monnify.com"

# Used for absolute URLs (metadata, OG images, redirect targets).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
